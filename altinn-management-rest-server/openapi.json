            "MaskinportenSchema": {
                "type": "object",
                "title": "MaskinportenSchema",
                "description": "A resource of type `MaskinportenSchema` in Altinn, with the values Altinn has. A field Altinn has no value for is left out. `title` is its name, `description` says what it gives access to, and `delegationDescription` explains the rights an organisation gets when the resource is delegated to it.",
                "required": [
                    "resourceId"
                ],
                "properties": {
                    "resourceId": {
                        "type": "string",
                        "description": "The resource's id in Altinn: 4 or more of `a-z`, `0-9`, `_` and `-`. It cannot be changed."
                    },
                    "scopes": {
                        "type": "array",
                        "description": "The Maskinporten scopes the resource is for. An organisation the resource is delegated to in Altinn can get tokens with these scopes on behalf of the organisation that delegated it.",
                        "items": {
                            "type": "string"
                        }
                    },
                    "title": {
                        "$ref": "#/components/schemas/MultilingualText"
                    },
                    "description": {
                        "$ref": "#/components/schemas/MultilingualText"
                    },
                    "delegationDescription": {
                        "$ref": "#/components/schemas/MultilingualText"
                    },
                    "homepage": {
                        "type": "string",
                        "description": "A web page about the resource."
                    },
                    "contactPoints": {
                        "type": "array",
                        "description": "Where to get help with the resource. Can be empty.",
                        "items": {
                            "$ref": "#/components/schemas/ContactPoint"
                        }
                    },
                    "keywords": {
                        "type": "array",
