                    }
                }
            },
            "FieldError": {
                "type": "object",
                "title": "FieldError",
                "required": [
                    "field",
                    "code",
                    "message"
                ],
                "properties": {
                    "field": {
                        "type": "string",
                        "description": "The query parameter, path parameter, header or body field."
                    },
                    "code": {
                        "type": "string",
