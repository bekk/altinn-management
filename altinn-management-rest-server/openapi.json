                "properties": {
                    "type": {
                        "type": "string",
                        "description": "What went wrong, as a name that does not change, so your code can rely on it.\n\n- `tag:kartverket.no,2026:validation-error` (400): one or more fields are missing or invalid. `errors` lists all of\n  them.\n- `tag:kartverket.no,2026:malformed-request` (400): the request could not be read, for example a body that is not\n  valid JSON, a field with the wrong type, or a `Content-Type` that is not `application/json`.\n- `tag:kartverket.no,2026:upstream-rejected` (400): the values passed this API's checks, but Altinn rejected them.\n- `tag:kartverket.no,2026:not-found` (404): there is nothing at this path: no endpoint, or no MaskinportenSchema\n  with this id.\n- `tag:kartverket.no,2026:method-not-allowed` (405): the endpoint at this path does not accept this HTTP method.\n- `tag:kartverket.no,2026:upstream-error` (502): this API could not get a usable answer from Altinn, or from the\n  service that says which resources and scopes the calling app has access to. Your request did not cause it.\n- `tag:kartverket.no,2026:internal-error` (500): an unexpected error in this API.",
                        "enum": [
                            "tag:kartverket.no,2026:validation-error",
                            "tag:kartverket.no,2026:malformed-request",
                            "tag:kartverket.no,2026:upstream-rejected",
                            "tag:kartverket.no,2026:not-found",
                            "tag:kartverket.no,2026:method-not-allowed",
                            "tag:kartverket.no,2026:upstream-error",
                            "tag:kartverket.no,2026:internal-error"
                        ]
                    },
                    "title": {
                        "type": "string",
                        "description": "A short name for the `type`, the same every time."
                    },
                    "status": {
                        "type": "integer",
                        "description": "The HTTP status code, the same as the response's."
                    },
                    "detail": {
                        "type": [
