{
    "openapi": "3.1.1",
    "info": {
        "title": "Altinn Management REST API",
        "version": "v0",
        "description": "Manages Kartverket's resources in Altinn's Resource Registry."
    },
    "paths": {
        "/api/maskinportenschemas": {
            "get": {
                "summary": "List Kartverket's MaskinportenSchemas",
                "description": "Gets Kartverket's resources of type `MaskinportenSchema` from Altinn. When filtering is on, this API only returns the ones the calling app has access to: the resource, and every one of its scopes, must be in the app's `exact` list or start with one of its prefixes. This API reads which app is calling from the `X-Forwarded-Client-Cert` header, which Istio usually sets.",
                "parameters": [
                    {
                        "name": "X-Forwarded-Client-Cert",
                        "in": "header",
                        "description": "Says which app is calling. Istio usually sets it on every call, so the app does not. This API requires it when filtering is on.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "X-Request-ID",
                        "in": "header",
                        "description": "An id to find this call by in this API's logs. Up to 128 ASCII letters, digits, `-`, `_`, `.` and `:`. Without it, or with any other value, this API makes a new one. Every response has the id in its `X-Request-Id` header.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "3f2b8c1e-7d4a-4f0e-9b6a-2c5d8e1f4a7b"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Kartverket's MaskinportenSchemas, or when filtering is on, the ones the calling app has access to. The list is empty if there are none.",
                        "headers": {
                            "X-Request-ID": {
                                "description": "The id of this call in this API's logs: the `X-Request-Id` you sent, or a new one.",
                                "required": true,
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/MaskinportenSchema"
                                    }
                                },
                                "examples": {
                                    "MaskinportenSchemas": {
                                        "value": [
                                            {
                                                "resourceId": "kv-matrikkel-brukernavn",
                                                "scopes": [
                                                    "kartverk:matrikkel:brukernavn"
                                                ],
                                                "title": {
                                                    "en": "Cadastre API",
                                                    "nb": "Matrikkel API",
                                                    "nn": "Matrikkel API"
                                                },
                                                "description": {
                                                    "en": "Machine-to-machine access to the Cadastre.",
                                                    "nb": "Maskinell tilgang til Matrikkelen.",
                                                    "nn": "Maskinell tilgang til Matrikkelen."
                                                },
                                                "delegationDescription": {
                                                    "en": "Allows a system provider to use the Matrikkel API on behalf of your organisation.",
                                                    "nb": "Gir en systemleverandør rett til å bruke Matrikkel API på vegne av virksomheten din.",
                                                    "nn": "Gir ein systemleverandør rett til å bruke Matrikkel API på vegner av verksemda di."
                                                },
                                                "homepage": "https://kartverket.github.io/api-dokumentasjon/docs/matrikkelen",
                                                "contactPoints": [
                                                    {
                                                        "category": "Kartverket Kundesenter",
                                                        "email": "kundesenter@kartverket.no"
                                                    }
                                                ],
                                                "keywords": [
                                                    {
                                                        "word": "matrikkel",
                                                        "language": "nb"
                                                    },
                                                    {
                                                        "word": "cadastre",
                                                        "language": "en"
                                                    }
                                                ],
                                                "status": "Completed",
                                                "delegable": true,
                                                "visible": true
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Filtering is on and the `X-Forwarded-Client-Cert` header is missing, so this API cannot tell which app is calling.",
                        "headers": {
                            "X-Request-ID": {
                                "description": "The id of this call in this API's logs: the `X-Request-Id` you sent, or a new one.",
                                "required": true,
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "MissingClientCertificate": {
                                        "value": {
                                            "type": "tag:kartverket.no,2026:validation-error",
                                            "title": "Validation failed",
                                            "status": 400,
                                            "errors": [
                                                {
                                                    "field": "X-Forwarded-Client-Cert",
                                                    "code": "MISSING",
                                                    "message": "X-Forwarded-Client-Cert is required"
                                                }
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "This API could not get an answer from Altinn, or from the service that says which resources and scopes the calling app has access to. Your request did not cause it.",
                        "headers": {
                            "X-Request-ID": {
                                "description": "The id of this call in this API's logs: the `X-Request-Id` you sent, or a new one.",
                                "required": true,
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "UpstreamError": {
                                        "value": {
                                            "type": "tag:kartverket.no,2026:upstream-error",
                                            "title": "A service this API depends on failed",
                                            "status": 502,
                                            "detail": "The call to Altinn failed"
                                        }
                                    },
                                    "FilteringError": {
                                        "value": {
                                            "type": "tag:kartverket.no,2026:upstream-error",
                                            "title": "A service this API depends on failed",
                                            "status": 502,
                                            "detail": "The call to the filtering service failed"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "An unexpected error in this API.",
                        "headers": {
                            "X-Request-ID": {
                                "description": "The id of this call in this API's logs: the `X-Request-Id` you sent, or a new one.",
                                "required": true,
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "InternalError": {
                                        "value": {
                                            "type": "tag:kartverket.no,2026:internal-error",
                                            "title": "Internal error",
                                            "status": 500
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/maskinportenschemas/{id}": {
            "get": {
                "summary": "Get a MaskinportenSchema",
                "description": "Gets the resource with this id from Altinn. Only resources of type `MaskinportenSchema` are found: any other resource gives `404`, as if it did not exist.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "The resource's id: 4 or more of `a-z`, `0-9`, `_` and `-`, for example `kv-matrikkel-brukernavn`.",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[a-z0-9_-]{4,}$"
                        }
                    },
                    {
                        "name": "X-Request-ID",
                        "in": "header",
                        "description": "An id to find this call by in this API's logs. Up to 128 ASCII letters, digits, `-`, `_`, `.` and `:`. Without it, or with any other value, this API makes a new one. Every response has the id in its `X-Request-Id` header.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "3f2b8c1e-7d4a-4f0e-9b6a-2c5d8e1f4a7b"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The MaskinportenSchema.",
                        "headers": {
                            "X-Request-ID": {
                                "description": "The id of this call in this API's logs: the `X-Request-Id` you sent, or a new one.",
                                "required": true,
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MaskinportenSchema"
                                },
                                "examples": {
                                    "MaskinportenSchema": {
                                        "value": {
                                            "resourceId": "kv-matrikkel-brukernavn",
                                            "scopes": [
                                                "kartverk:matrikkel:brukernavn"
                                            ],
                                            "title": {
                                                "en": "Cadastre API",
                                                "nb": "Matrikkel API",
                                                "nn": "Matrikkel API"
                                            },
                                            "description": {
                                                "en": "Machine-to-machine access to the Cadastre.",
                                                "nb": "Maskinell tilgang til Matrikkelen.",
                                                "nn": "Maskinell tilgang til Matrikkelen."
                                            },
                                            "delegationDescription": {
                                                "en": "Allows a system provider to use the Matrikkel API on behalf of your organisation.",
                                                "nb": "Gir en systemleverandør rett til å bruke Matrikkel API på vegne av virksomheten din.",
                                                "nn": "Gir ein systemleverandør rett til å bruke Matrikkel API på vegner av verksemda di."
                                            },
                                            "homepage": "https://kartverket.github.io/api-dokumentasjon/docs/matrikkelen",
                                            "contactPoints": [
                                                {
                                                    "category": "Kartverket Kundesenter",
                                                    "email": "kundesenter@kartverket.no"
                                                }
                                            ],
                                            "keywords": [
                                                {
                                                    "word": "matrikkel",
                                                    "language": "nb"
                                                },
                                                {
                                                    "word": "cadastre",
                                                    "language": "en"
                                                }
                                            ],
                                            "status": "Completed",
                                            "delegable": true,
                                            "visible": true
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The id is not valid.",
                        "headers": {
                            "X-Request-ID": {
                                "description": "The id of this call in this API's logs: the `X-Request-Id` you sent, or a new one.",
                                "required": true,
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "InvalidId": {
                                        "value": {
                                            "type": "tag:kartverket.no,2026:validation-error",
                                            "title": "Validation failed",
                                            "status": 400,
                                            "errors": [
                                                {
                                                    "field": "id",
                                                    "code": "INVALID_FORMAT",
                                                    "message": "id must be 4 or more of a-z, 0-9, _ and -"
                                                }
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Altinn has no MaskinportenSchema with this id.",
                        "headers": {
                            "X-Request-ID": {
                                "description": "The id of this call in this API's logs: the `X-Request-Id` you sent, or a new one.",
                                "required": true,
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "NotFound": {
                                        "value": {
                                            "type": "tag:kartverket.no,2026:not-found",
                                            "title": "Not found",
                                            "status": 404,
                                            "detail": "There is no MaskinportenSchema with this id"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "This API could not get an answer from Altinn. Your request did not cause it.",
                        "headers": {
                            "X-Request-ID": {
                                "description": "The id of this call in this API's logs: the `X-Request-Id` you sent, or a new one.",
                                "required": true,
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "UpstreamError": {
                                        "value": {
                                            "type": "tag:kartverket.no,2026:upstream-error",
                                            "title": "A service this API depends on failed",
                                            "status": 502,
                                            "detail": "The call to Altinn failed"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "An unexpected error in this API.",
                        "headers": {
                            "X-Request-ID": {
                                "description": "The id of this call in this API's logs: the `X-Request-Id` you sent, or a new one.",
                                "required": true,
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "examples": {
                                    "InternalError": {
                                        "value": {
                                            "type": "tag:kartverket.no,2026:internal-error",
                                            "title": "Internal error",
                                            "status": 500
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
