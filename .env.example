# Copy to .env and fill in the values. .env is gitignored.
#
# Nothing reads this file directly. scripts/dev.sh exports it, and the server then resolves the variables through
# the $ENV_VAR references in altinn-management-rest-server/src/main/resources/application.yaml. Starting the server
# any other way - an IDE run configuration, a bare ./gradlew run - means putting these in the environment yourself.

# Required.

# Which Altinn to talk to: TT02, PROD or LOCAL. It picks both Altinn's platform and Maskinporten, which issues the
# tokens Altinn's write endpoints require:
# - TT02: https://platform.tt02.altinn.no and https://test.maskinporten.no
# - PROD: https://platform.altinn.no and https://maskinporten.no
# - LOCAL: the mock API in mock-api on http://localhost:8090, which plays both
ALTINN_ENVIRONMENT=LOCAL

# Our client at Maskinporten, which gets the tokens Altinn's write endpoints require. It asks for the scope
# altinn:resourceregistry/resource.write. LOCAL takes any client id.
MASKINPORTEN_CLIENT_ID=dev-client

# The client's private key, as an RSA JWK on a single line. The key below is made up for local runs and is not a
# secret: it belongs to no client at Maskinporten, so it cannot get a token from TT02 or PROD, and it only works
# against LOCAL because the mock does not check signatures. For TT02 and PROD, use the key of the client registered
# at Maskinporten, and keep that key secret.
# scripts/dev.sh loads this file by sourcing it as a shell script, so wrap the JSON in single quotes - otherwise the
# double quotes get stripped and the JWK fails to parse.
MASKINPORTEN_CLIENT_JWK='{"p":"2yuxPg9lIQYb5Z5IeGrtHjxOBRhaMuqv-Hwro8mnbFFNKPoaj-BPxzK9zoGzdALFh54WU0hD4UGBhty9ydP5sPe1FlJ1ylCjpchlw7Wz4luMqvX-FoZab0trPp4BB2006u8kXTHdUbBHRuMrx3VKCC7JUL_syLtxsdz3IULII5c","kty":"RSA","q":"_U1ld70Ynyg73GjxxjAU9CFFATvZgjgKhsUIsQ2RALJwDfVn1k7Ub7VRDp0ZcBoqIjmEr39hLTCY1QAk7VIEZ35CGtsOkfBGVwComwbokRLQl4HIVB785XK3Hf0tYjy11eShECfqquuGWsQMtD_BW0o6xZ-fcPjZa1qWG-n5N2c","d":"X7gVYIMIUsMY0BxWIvFOA68Qo9VXnvVlQDxQO9TgrKt7_yGiC3AmCPxsNI8r9bqv9TxF691_4JXvan5i-cTQc0u1AIGrkgGBMh3Ur8_RX1nt05szS_9LI0RxIRMSvW3Enx-EPGW_ELwIVYG7rvRlm8ksGBxfma6IFsb2HRRWMRfPpxPRRwOXQ36ripjv9Jor963bVr0MYTLJdNYNuYTChjMPMCrokPNCrtM2Z5ajaF01Ww1xMai-gTI1xHi3538pnrT2snOfbEcAjjDxENnVkugYDHH3KGwMXcnNkiqSdWgvFLuIJamz2GgUcRsP7q-GxLcyK0s0rApsf9I9jEccPQ","e":"AQAB","kid":"local-dev-not-a-secret","qi":"lSMpWybVUlbWyG_osgberqfQf9gd41zKFeGgx6R10_lonVqanO4zFNDNiaQBebvqU2maHKA1Glku4vwlTDM1cHx1qnTyCBkUxYm1Rad1fhRfGyoiVBEz0ym2_HWIuYy0ZObkKuJPEjCqeIxq9M1SngNWAsLxJ51X2b3QWM2FUD4","dp":"N4EQKOxTKxLV-8ejCMPjevXAuG-bYCupFt-zWY5XFQpd5RO5qFghPAwwn1yfarDM_3RcqQizEBe7ysCaW8OQB24j8Rw-8laLqw9eHjsk7B1NOXqEt4Wc33SVG01-azgP37NiXSukpexjkKM1UhT1A699kjKYr5kwyN9xwn2cG88","dq":"yUhtbx72p9Ki7tz98w1WOUEOwpI6n33E75827urm5PTmklEGeIgfy7z7cm9oPWqtPJEUXRkNsYlCiVAaB_P6x_rOsOSNyW5zlsNROA_fUxjuZNaeyCnvsKzd0pjTLZMss5GAY4Q0uCl8lDfiGIHpNo_f8BaN7onwy5wqWHgur9U","n":"2NxxLWUCyTAKyjGz-Sm3xrKlbfoi9anbdulpE2HW99C2VJDmfs10KhyYeWEUKLuYvTZN3ME1O5EX8VM-99jwSt8Jcdd8athWMb7NIvzsADTKf5s-Uo6HOxrBs5eR6YIVp5dRcczcWSC6NvnXmP0BP9vSGSfLl3Lp17mHDuFvWlHxhqae9K-mENq-vQsY7XRdKcrOOd5DX3LqlR-TGIBU09uQb67L68HPQfQ8jjPrz_u0pC-etN1jI2zW2Li8KMoqY7RjV648n47nNgvuBeeiXlWRlyXgZY_e9VvfD85aXvkjedXgw3TCHu5W1o3d9wq_HX2Idg5oFq2eLeu26wrCwQ"}'

# Optional - the values below are the defaults.

# Port the server listens on.
PORT=8080

# Access logging: one log line per HTTP request. true or false.
ACCESS_LOG_ENABLED=true

# Path to a logback.xml that replaces the bundled one.
LOGBACK_CONFIG_FILE=
